# Copy to .env (repo root), web/.env.local and server/.env as noted.
# Nothing here is a real credential.

# --- shared: root .env, web/.env.local AND server/.env ---
# One Neon connection string, kept in sync across all three by hand.
DATABASE_URL=postgres://user:password@host.neon.tech/dbname?sslmode=require

# --- web/.env.local ---
BETTER_AUTH_SECRET=generate-with-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Deployment prerequisite: without the proxy CIDRs, getIp trusts a
# client-supplied x-forwarded-for and every IP-keyed rate limit is bypassable.
TRUSTED_PROXIES=

# Brevo (transactional email: signup / password-reset / email-change OTPs).
# BREVO_FROM_EMAIL must be a sender you have VERIFIED in the Brevo dashboard
# (Senders, Domains & IPs -> Senders -> Add a sender -> enter the 6-digit code
# it emails you). Sending from an unverified address is refused with a 400.
BREVO_API_KEY=xkeysib-xxx
BREVO_FROM_EMAIL=you@example.com
BREVO_FROM_NAME=ChatSphere

# Use an unrestricted key, or a scoped one granted `create` and `read` — a key
# without `create` answers 403 on every upload while `ping()` still succeeds,
# which makes it look like an outage rather than a permissions problem.
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=xxx
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud

# --- chat realtime: web/.env.local ---
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
SOCKET_INTERNAL_URL=http://localhost:4000

# --- chat realtime: server/.env ---
SOCKET_PORT=4000
WEB_ORIGIN=http://localhost:3000
WEB_INTERNAL_URL=http://localhost:3000
# Set to false only when running more than one socket process — the boot-time
# presence reset is wrong the moment there are two.
SOCKET_SINGLE_INSTANCE=true

# --- these two must be IDENTICAL in web/.env.local and server/.env ---
# A mismatch rejects every media message; a missing value answers 503.
MEDIA_SIGNING_SECRET=generate-with-openssl-rand-hex-32
INTERNAL_API_SECRET=generate-with-openssl-rand-hex-32
