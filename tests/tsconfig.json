{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Two specs reach into web/src (85 via the alias, 90 relatively) — mirror
    // web/tsconfig.json's jsx + alias so `tsc -p tests` checks what vitest runs.
    "jsx": "react-jsx",
    "paths": { "@/*": ["../web/src/*"] },
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vitest/globals", "node"]
  },
  "include": ["src", "specs", "global-setup.ts", "vitest.config.ts", "provided.d.ts"]
}
