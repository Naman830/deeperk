diff --git a/web/src/lib/chat/reaction-store.ts b/web/src/lib/chat/reaction-store.ts
new file mode 100644
index 0000000..d611bd8
--- /dev/null
+++ b/web/src/lib/chat/reaction-store.ts
@@ -0,0 +1,92 @@
+import type { MessageReaction, ReactionMap } from "./types";
+
+/**
+ * Reactions, kept out of the message objects entirely.
+ *
+ * The alternative — a `reactions` array on ChatMessage — looks tidier and is
+ * measurably worse: mergeMessages rebuilds the rendered list from message
+ * identity, so one person tapping an emoji would produce a new object for that
+ * message, a new array for the list, and a re-render of every bubble on screen.
+ * Here a reaction changes only the snapshot that the reacted-to bubble reads.
+ *
+ * Same useSyncExternalStore shape as live-store.ts, and for the same reason:
+ * the server cannot see this data, so a useState initializer would differ
+ * between the SSR render and the first client render.
+ */
+
+const byMessage = new Map<string, MessageReaction[]>();
+const listeners = new Set<() => void>();
+
+// getSnapshot must return a referentially identical value between calls, or
+// React throws "The result of getSnapshot should be cached". One frozen empty
+// array, shared by every message that has no reactions — which is most of them.
+const EMPTY: readonly MessageReaction[] = Object.freeze([]);
+
+function emit() {
+  for (const listener of listeners) listener();
+}
+
+export function subscribeReactions(listener: () => void): () => void {
+  listeners.add(listener);
+  return () => listeners.delete(listener);
+}
+
+export function getReactions(messageId: string): readonly MessageReaction[] {
+  return byMessage.get(messageId) ?? EMPTY;
+}
+
+/** Stable across renders, and always empty — the server has no reaction store. */
+export function getServerReactions(): readonly MessageReaction[] {
+  return EMPTY;
+}
+
+/**
+ * Seed from a history page.
+ *
+ * Replaces rather than merges: the server's answer is authoritative for the
+ * messages it covers, and a merge would resurrect a reaction that was removed
+ * while this tab was disconnected.
+ */
+export function seedReactions(map: ReactionMap): void {
+  let changed = false;
+  for (const [messageId, reactions] of Object.entries(map)) {
+    byMessage.set(messageId, reactions.map((entry) => ({ emoji: entry.emoji, userIds: [...entry.userIds] })));
+    changed = true;
+  }
+  if (changed) emit();
+}
+
+/** One toggle, from the socket or from an optimistic local apply. Idempotent. */
+export function applyReaction(messageId: string, emoji: string, userId: string, added: boolean): void {
+  const current = byMessage.get(messageId) ?? [];
+  const index = current.findIndex((entry) => entry.emoji === emoji);
+  const entry = index === -1 ? null : current[index];
+  const has = entry?.userIds.includes(userId) ?? false;
+  // Idempotent in both directions: the actor applies optimistically AND
+  // receives the room broadcast, so every toggle arrives twice.
+  if (added === has) return;
+
+  let next: MessageReaction[];
+  if (added) {
+    next = entry
+      ? current.map((item, i) => (i === index ? { ...item, userIds: [...item.userIds, userId] } : item))
+      : [...current, { emoji, userIds: [userId] }];
+  } else {
+    const remaining = entry!.userIds.filter((id) => id !== userId);
+    // An emoji nobody is using any more is removed outright, so an empty chip
+    // never renders.
+    next =
+      remaining.length === 0
+        ? current.filter((_, i) => i !== index)
+        : current.map((item, i) => (i === index ? { ...item, userIds: remaining } : item));
+  }
+
+  if (next.length === 0) byMessage.delete(messageId);
+  else byMessage.set(messageId, next);
+  emit();
+}
+
+export function clearReactions(): void {
+  byMessage.clear();
+  emit();
+}
