+          <div className="scroll-thin max-h-64 overflow-y-auto">
+            {EMOJI_GROUPS.map((group) => (
+              <div key={group.label} className="mb-2 last:mb-0">
+                <p className="text-muted-foreground px-1 pb-1 text-[11px] font-medium">{group.label}</p>
+                <div className="grid grid-cols-8 gap-0.5">
+                  {group.emoji.map((emoji) => (
+                    <button
+                      key={emoji}
+                      type="button"
+                      aria-label={`React ${emoji}`}
+                      onClick={() => {
+                        onPick(emoji);
+                        setOpen(false);
+                      }}
+                      className={cn(
+                        "hover:bg-accent grid size-8 place-items-center rounded-md text-lg",
+                        mine.has(emoji) && "bg-accent",
+                      )}
+                    >
+                      {emoji}
+                    </button>
+                  ))}
+                </div>
+              </div>
+            ))}
+          </div>
+        </PopoverContent>
+      </Popover>
+    </div>
+  );
+}
