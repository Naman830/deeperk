+ * No emoji-picker dependency — see lib/chat/emoji.ts for why. The grid is a
+ * plain scrollable list of buttons, which is also the only version that is
+ * keyboard-navigable without extra work.
+ */
+export function ReactionBar({
+  onPick,
+  mine,
+  className,
+}: {
+  onPick: (emoji: string) => void;
+  /** Emoji this viewer has already used on the message, so they read as active. */
+  mine: ReadonlySet<string>;
+  className?: string;
+}) {
+  const [open, setOpen] = useState(false);
+
+  return (
+    <div
+      className={cn(
+        "bg-popover flex items-center gap-0.5 rounded-full border p-1 shadow-lg",
+        className,
+      )}
+    >
+      {QUICK_REACTIONS.map((emoji) => (
+        <button
+          key={emoji}
+          type="button"
+          aria-label={`React ${emoji}`}
