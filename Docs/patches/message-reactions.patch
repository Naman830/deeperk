@@ -0,0 +1,62 @@
+import { useSyncExternalStore } from "react";
+import { getReactions, getServerReactions, subscribeReactions } from "@/lib/chat/reaction-store";
+import { cn } from "@/lib/utils";
+
+// No "use client": rendered from message-bubble.tsx.
+
+/**
+ * The reaction chips under a bubble.
+ *
+ * Subscribed per message rather than passed down from the thread: a reaction on
+ * one message must re-render that message's chips and nothing else. Reading the
+ * whole map in chat-thread and threading it through message-list would put
+ * every bubble on screen back through render for one tap.
+ */
+export function ReactionChips({
+  messageId,
+  viewerId,
+  onToggle,
+  align,
+}: {
+  messageId: string;
+  viewerId: string;
+  onToggle: (emoji: string) => void;
+  align: "start" | "end";
+}) {
+  const reactions = useSyncExternalStore(
+    subscribeReactions,
+    () => getReactions(messageId),
+    getServerReactions,
+  );
+
+  if (reactions.length === 0) return null;
+
+  return (
+    <span
+      className={cn("mt-1 flex flex-wrap gap-1", align === "end" ? "justify-end" : "justify-start")}
+    >
+      {reactions.map((entry) => {
+        const mine = entry.userIds.includes(viewerId);
+        return (
+          <button
+            key={entry.emoji}
+            type="button"
+            onClick={() => onToggle(entry.emoji)}
+            aria-pressed={mine}
+            aria-label={`${entry.emoji} ${entry.userIds.length}`}
+            className={cn(
+              "flex items-center gap-1 rounded-full border px-1.5 py-0.5 text-[11px] leading-none",
+              "transition-colors",
+              mine
+                ? "border-primary/40 bg-primary/15 text-primary"
+                : "bg-muted/60 hover:bg-muted border-transparent",
+            )}
+          >
+            <span className="text-xs leading-none">{entry.emoji}</span>
+            <span className="tabular-nums">{entry.userIds.length}</span>
+          </button>
+        );
+      })}
+    </span>
+  );
+}
