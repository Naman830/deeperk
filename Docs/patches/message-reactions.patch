new file mode 100644
index 0000000..233c0fd
--- /dev/null
+++ b/server/src/emoji.js
@@ -0,0 +1,36 @@
+/**
+ * What counts as a reaction emoji.
+ *
+ * A property-escape check rather than a hard-coded allowlist mirrored on both
+ * sides. An allowlist would have to exist twice — here (CommonJS) and in
+ * web/src/lib/chat/emoji.ts — and the two would drift the first time the picker
+ * gains a row, at which point the server silently rejects an emoji the UI
+ * offers. This asks the real question instead: "is this one emoji?"
+ *
+ * \p{RGI_Emoji} needs the `v` flag (Node 20+, Chrome 112+, Safari 17+). That is
+ * fine HERE because this file only ever runs in Node — it is deliberately not
+ * shared with the browser, where an older engine would throw a SyntaxError at
+ * parse time and take the whole bundle down. The client picker uses a curated
+ * list instead, so it never needs this regex.
+ *
+ * The client offers ~60 curated emoji; this accepts any single RGI emoji. That
+ * asymmetry is intentional and safe: the stored value is rendered as plain text
+ * through JSX, so the only thing being defended is "one grapheme, not a
+ * 4000-character string smuggled into a text column".
+ */
+const SINGLE_EMOJI = /^\p{RGI_Emoji}$/v;
+
+// Belt and braces before the regex: RGI sequences top out well under this, and
+// it bounds the work the regex engine can be asked to do.
+const MAX_EMOJI_BYTES = 64;
+
+function isValidEmoji(value) {
+  return (
+    typeof value === "string" &&
+    value.length > 0 &&
+    Buffer.byteLength(value, "utf8") <= MAX_EMOJI_BYTES &&
+    SINGLE_EMOJI.test(value)
+  );
+}
+
+module.exports = { isValidEmoji };
