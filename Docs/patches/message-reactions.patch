+            "grid size-8 place-items-center rounded-full text-base transition-transform",
+            "hover:bg-accent hover:scale-125 active:scale-110 motion-reduce:hover:scale-100",
+            mine.has(emoji) && "bg-accent",
+          )}
+        >
+          {emoji}
+        </button>
