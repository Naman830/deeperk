new file mode 100644
index 0000000..2429922
--- /dev/null
+++ b/db/schema/chat/reaction.js
@@ -0,0 +1,58 @@
+// Emoji reactions on a message. One row per (message, user, emoji), so a person
+// can leave several different reactions on the same message but each one only
+// once — the shape Docs/chat/chat.md §9 itself proposes.
+
+const {
+  pgTable,
+  text,
+  timestamp,
+  primaryKey,
+} = require("drizzle-orm/pg-core");
+const { user } = require("../auth/user");
+const { message } = require("./message");
+
+/*
+message
+   │
+   ├── reaction ── user A  "❤️"
+   ├── reaction ── user B  "❤️"
+   └── reaction ── user A  "👍"   (same user, different emoji — allowed)
+*/
+const reaction = pgTable(
+  "reaction",
+  {
+    // CASCADE, same reasoning as message_deletion: a reaction on a message that
+    // no longer exists records nothing. Delete-for-everyone is a soft delete, so
+    // this only fires on a genuine hard delete.
+    messageId: text("message_id")
+      .notNull()
+      .references(() => message.id, { onDelete: "cascade" }),
+
+    // RESTRICT, matching the repo-wide rule for FKs to user.
+    userId: text("user_id")
+      .notNull()
+      .references(() => user.id, { onDelete: "restrict" }),
+
+    // Plain text with app-level validation, not a pgEnum — exactly the case
+    // CLAUDE.md decision #2 carves out. The set churns, and a native enum needs
+    // an ALTER TYPE under this repo's drizzle-kit push workflow.
+    emoji: text("emoji").notNull(),
+
+    createdAt: timestamp("created_at", { withTimezone: true })
+      .notNull()
+      .defaultNow(),
+  },
+  (table) => [
+    // Makes toggling idempotent: onConflictDoNothing on the way in, a delete on
+    // the way out, so a double-tap can never produce two rows.
+    primaryKey({ columns: [table.messageId, table.userId, table.emoji] }),
+
+    // No secondary index on message_id, for the same reason message_deletion
+    // has none: the PK's leading column IS message_id, so "every reaction on
+    // this page of messages" (message_id IN (...)) is already served by the PK
+    // btree. A narrower duplicate would buy a marginally smaller scan and cost
+    // a second index to maintain on every toggle.
+  ],
+);
+
+module.exports = { reaction };
